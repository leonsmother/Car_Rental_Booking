# Copy this file to .env (same folder) and fill in the real values.
# .env is git-ignored: NEVER commit it. This example file has no secrets and IS committed.

# Neon DEV branch connection string for catalogue_role (the role you created)
DATABASE_URL=postgresql://catalogue_role:PASSWORD@HOST.neon.tech/neondb?sslmode=require

# Lets you pretend to be staff/customer locally with the x-dev-user header.
# Only works on your laptop, never in AWS Lambda.
LOCAL_AUTH=true
